{
  "name": "imgpull",
  "version": "1.1.3",
  "description": "CLI tool to download images directly from URLs and auto-convert from webp (or any format) to png/jpg/etc., without third-party downloader sites or ImageMagick.",
  "type": "module",
  "bin": {
    "imgpull": "./bin/imgpull.js"
  },
  "main": "./bin/imgpull.js",
  "author": "caya8205-2",
  "license": "MIT",
  "keywords": [
    "image",
    "downloader",
    "converter",
    "webp",
    "png",
    "jpg",
    "avif",
    "sharp",
    "cli",
    "tui",
    "ink",
    "instagram"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caya8205-2/imgpull.git"
  },
  "bugs": {
    "url": "https://github.com/caya8205-2/imgpull/issues"
  },
  "homepage": "https://github.com/caya8205-2/imgpull#readme",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node ./bin/imgpull.js --help",
    "prepublishOnly": "echo 'Ready to publish to npm'"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "ink": "^7.1.0",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.7",
    "sharp": "^0.33.5"
  }
}
